
.contact-details {
  max-width: 600px;
  margin: 40px auto;
  padding: 30px;
  background: #ffffff;
  border-radius: 15px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  font-family: Arial, sans-serif;
}

.contact-details h2 {
  color: #166534;
  margin-bottom: 25px;
}

.contact-details p {
  margin: 18px 0;
  color: #333333;
  line-height: 1.7;
}

.contact-details a {
  color: #15803d;
  text-decoration: none;
  overflow-wrap: anywhere;
}

.contact-details a:hover {
  color: #14532d;
  text-decoration: underline;
}
